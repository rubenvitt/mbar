{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "mbar",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "crates/mbar-ui/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value.startsWith('mbar'))].version" },
        { "type": "toml", "path": "crates/mbar-ui/Cargo.lock", "jsonpath": "$.package[?(@.name.value.startsWith('mbar'))].version" }
      ]
    }
  }
}
